# ---- Public (shipped to the browser) ----
NEXT_PUBLIC_CHAIN_ID=1                     # 1 = Ethereum mainnet, 31337 = local anvil
NEXT_PUBLIC_RPC_URL=                       # browser RPC (domain-restricted key recommended)
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_FACTORY_DEPLOY_BLOCK=
NEXT_PUBLIC_USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=      # https://cloud.reown.com
NEXT_PUBLIC_WORLD_APP_ID=app_              # World Developer Portal
NEXT_PUBLIC_WORLD_ACTION=ai-city-verify-human
NEXT_PUBLIC_WORLD_ENV=production           # "staging" to test with simulator.worldcoin.org

# ---- Server only ----
RPC_URL=                                   # private RPC for server reads
DATABASE_URL=                              # Postgres (Neon in production)
SESSION_SECRET=                            # 32+ random chars: openssl rand -hex 32
WORLD_RP_ID=rp_
WORLD_RP_SIGNING_KEY=                      # hex signing key from the Developer Portal
WORLD_STAGING_VERIFICATION_TOKEN=          # staging only: token from the portal's 24h staging verification window
DOOR_API_KEY=                               # shared secret between pi4-door.py and door/status API

# ---- Local development only ----
# ALLOW_DEV_VERIFY=1
# NEXT_PUBLIC_ALLOW_DEV_VERIFY=1

# Argo private journal link (lib/server/argo.ts). A dedicated secp256k1 key the concierge signs
# Argo info requests with; never reuse a wallet that holds funds. Generate: 0x$(openssl rand -hex 32)
ARGO_AGENT_PRIVATE_KEY=
# Optional. Argo only accepts a public HTTPS webhook; defaults to https://<this host>/api/argo/webhook.
ARGO_WEBHOOK_URL=
# Optional. Defaults to https://api.luminalog.com
ARGO_API_URL=
