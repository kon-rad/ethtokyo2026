[Unit]
Description=AI City offline transaction signer (USB serial gadget)
Documentation=https://github.com/kon-rad/ethtokyo2026/blob/main/docs/pi-zero-offline-signer-setup.md
# The Zero boots on every door insertion, so start as soon as the disk and the serial
# gadget are up instead of waiting for basic.target.
DefaultDependencies=no
After=local-fs.target dev-ttyGS0.device
Wants=dev-ttyGS0.device

[Service]
ExecStart=/opt/zero-signer/venv/bin/python /opt/zero-signer/zero-tx-signer.py
User=REPLACE_USER
Group=dialout
StateDirectory=zero-signer
StateDirectoryMode=0700
Environment=ZERO_KEY_FILE=/var/lib/zero-signer/mnemonic
Environment=ZERO_CHAIN_IDS=11155111
Nice=-10
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
