# AI City door, read by aicity-door.service from /boot/firmware/door.env.
# Edit it from the Mac with the SD card in the reader, then boot the Pi.

# Who opens the door:
#   pair    the first Pi Zero key plugged in is enrolled; after that only it opens
#   staked  the key's address is the residency's host or has staked (Sepolia)
#   active  host or staked, residency Active, and today inside its dates
# To re-pair, delete /var/lib/aicity-door/paired-address on the Pi.
DOOR_RULE=pair

# Blank = use the residency in board-url.txt (/r/<address>/board)
RESIDENCY_ADDRESS=
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

DOOR_OPEN_SECONDS=30
# Swap these if the latch turns the wrong way
LOCKED_ANGLE=0
UNLOCKED_ANGLE=90

# Blank = the origin in board-url.txt (where check-ins are recorded for the board)
APP_URL=

# Shared secret for posting door status to the app (for the board's real-time indicator).
# Set this to the same value as DOOR_API_KEY in the app's .env.local.
DOOR_API_KEY=
